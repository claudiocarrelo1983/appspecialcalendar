{
  "expo": {
    "name": "FTX Team",
    "slug": "ftx",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo/ftx-icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.ftxteam.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "A FTX Team utiliza a câmara para tirar uma fotografia e atualizar a sua foto de perfil.",
        "NSPhotoLibraryUsageDescription": "A FTX Team permite escolher uma fotografia da sua biblioteca para atualizar a sua foto de perfil.",
        "NSLocationWhenInUseUsageDescription": "A FTX Team utiliza a sua localização enquanto usa a aplicação para confirmar o local dos registos de presença."
      }
    },
    "android": {
      "package": "com.ftxteam.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "owner": "carrelo1983",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/ftx-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/logo/ftx-splash.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2c8e7c35-68dc-40c6-b7ea-461f61de6c93"
      }
    }
  }
}
